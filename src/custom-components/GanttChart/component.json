  "settings": {
    "schema": {
      "type": "object",
      "properties": {
        "theme": {
          "type": "string",
          "enum": [
            "light",
            "dark"
          ]
        },
        "defaultZoom": {
          "type": "string",
          "enum": [
            "week",
            "month",
            "quarter"
          ]
        },
        "showStats": {
          "type": "boolean"
        },
        "showToolbar": {
          "type": "boolean"
        },
        "showDependencies": {
          "type": "boolean"
        },
        "activeLocale": {
          "type": "string"
        },
        "i18n": {
          "type": "object",
          "description": "Multilingual labels. Keys = BCP-47 codes.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "width": {
          "type": "number",
          "default": 860
        },
        "height": {
          "type": "number",
          "default": 500
        }
      }
    }
