{
    "name": "StatCard",
    "category": "Cards",
    "type": "local",
    "entry": "./StatCard.tsx",
    "enabled": true,
    "multiLang": {
  "module": "statcard",
  "propMap": {
    "labelKey":       "label",
    "trendLabelKey":  "trendLabel",
    "targetLabelKey": "targetLabel"
  }
},
    "ui": {
        "canvasIcon": "./stat-canvas-icon.svg"
    },
    "presets": [
        {
            "id": "stat-card",
            "label": "Stat Card",
            "thumbnail": "📊",
            "defaultProps": {
                "labelKey": "metricName",
                "value": 0,
                "unit": "",
                "trend": "auto",
                "trendValue": 0,
                "positiveIsGood": true,
                "target": null,
                "accentColor": "indigo",
                "size": "md",
                "locale": "en",
                "sparkData": [],
                "icon": "chart-bar",
                "currency": null
            },
            "defaultActions": {
                "iconClick": {
                    "type": "redirect",
                    "url": "/",
                    "target": "_self"
                }
            }
        },
        {
            "id": "dashboard-cards",
            "label": "Dashboard Cards",
            "thumbnail": "📊",
            "defaultProps": {
                "cards": [
                    {
                        "labelKey": "activeProjects",
                        "value": "{{activeProjects}}",
                        "unit": "",
                        "trend": "auto",
                        "trendValue": "{{activeProjectsTrend}}",
                        "trendLabelKey": "new",
                        "positiveIsGood": true,
                        "target": null,
                        "accentColor": "amber",
                        "size": "md",
                        "locale": "en",
                        "sparkData": [],
                        "icon": "folder",
                        "currency": null
                    },
                    {
                        "labelKey": "onTrack",
                        "value": "{{onTrackPct}}",
                        "unit": "%",
                        "trend": "auto",
                        "trendValue": "{{onTrackTrend}}",
                        "trendLabelKey": "vsPrev",
                        "positiveIsGood": true,
                        "target": null,
                        "accentColor": "green",
                        "size": "md",
                        "locale": "en",
                        "sparkData": [],
                        "icon": "trending-up",
                        "currency": null
                    },
                    {
                        "labelKey": "delayedProjects",
                        "value": "{{delayedProjects}}",
                        "unit": "",
                        "trend": "auto",
                        "trendValue": "{{delayedTrend}}",
                        "trendLabelKey": "more",
                        "positiveIsGood": false,
                        "target": null,
                        "accentColor": "red",
                        "size": "md",
                        "locale": "en",
                        "sparkData": [],
                        "icon": "warning-triangle",
                        "currency": null
                    },
                    {
                        "labelKey": "revenueVsForecast",
                        "value": "{{revenueForecast}}",
                        "unit": "",
                        "trend": "neutral",
                        "trendValue": "{{revenueTrend}}",
                        "trendLabelKey": "vsPrev",
                        "positiveIsGood": true,
                        "target": "{{forecastTarget}}",
                        "targetLabelKey": "forecast",
                        "accentColor": "amber",
                        "size": "md",
                        "locale": "en",
                        "sparkData": [],
                        "icon": "currency-dollar",
                        "currency": {
                            "symbol": "$",
                            "position": "prefix",
                            "compact": true
                        }
                    },
                    {
                        "labelKey": "cashFlow",
                        "value": "{{cashFlow}}",
                        "unit": "",
                        "trend": "auto",
                        "trendValue": "{{cashFlowTrend}}",
                        "trendLabelKey": "healthy",
                        "positiveIsGood": true,
                        "target": null,
                        "accentColor": "green",
                        "size": "md",
                        "locale": "en",
                        "sparkData": [],
                        "icon": "wallet",
                        "currency": null
                    },
                    {
                        "labelKey": "resourceUtilization",
                        "value": "{{resourceUtilization}}",
                        "unit": "%",
                        "trend": "auto",
                        "trendValue": "{{resourceTrend}}",
                        "trendLabelKey": "vsPrev",
                        "positiveIsGood": true,
                        "target": null,
                        "accentColor": "cyan",
                        "size": "md",
                        "locale": "en",
                        "sparkData": [],
                        "icon": "person-group",
                        "currency": null
                    }
                ]
            }
        }
    ],
    "settings": {
        "schema": {
            "type": "object",
            "properties": {
                "labelKey": {
                    "type": "string",
                    "description": "i18n translation key for the metric name. Renders in all active languages via MultiLangLabel."
                },
                "label": {
                    "type": "string",
                    "description": "Plain string fallback for metric name. Used only when labelKey is not set."
                },
                "value": {
                    "type": ["number", "string"],
                    "description": "Primary numeric value. Accepts a number or a canvas binding like {{myVariable}}",
                    "x-binding": true
                },
                "unit": {
                    "type": "string",
                    "description": "Unit suffix e.g. %, ms, K"
                },
                "icon": {
                    "type": "string",
                    "description": "Icon identifier shown in the top-left of the card",
                    "enum": [
                        "folder",
                        "trending-up",
                        "trending-down",
                        "warning-triangle",
                        "currency-dollar",
                        "wallet",
                        "person-group",
                        "chart-bar",
                        "chart-pie",
                        "clock",
                        "check-circle",
                        "flag",
                        "bolt",
                        "star"
                    ]
                },
                "currency": {
                    "type": ["object", "null"],
                    "description": "Currency formatting config. Set null to disable.",
                    "properties": {
                        "symbol": {
                            "type": "string",
                            "description": "Currency symbol e.g. $, €, £, ₹, ¥",
                            "examples": ["$", "€", "£", "₹", "¥", "₩"]
                        },
                        "position": {
                            "type": "string",
                            "enum": ["prefix", "suffix"],
                            "description": "Whether symbol appears before or after the value"
                        },
                        "compact": {
                            "type": "boolean",
                            "description": "When true, shortens large numbers: 2400000000 → $2.4B"
                        },
                        "decimalPlaces": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 4,
                            "description": "Number of decimal places to show"
                        },
                        "code": {
                            "type": "string",
                            "description": "ISO 4217 currency code e.g. USD, EUR, INR",
                            "examples": ["USD", "EUR", "GBP", "INR", "JPY"]
                        }
                    },
                    "required": ["symbol", "position"]
                },
                "trendLabelKey": {
                    "type": "string",
                    "description": "i18n translation key for the trend badge label. Renders in all active languages.",
                    "examples": ["new", "more", "healthy", "vsPrev"]
                },
                "trendLabel": {
                    "type": "string",
                    "description": "Plain string fallback for trend badge label. Used only when trendLabelKey is not set."
                },
                "trendValue": {
                    "type": ["number", "string"],
                    "description": "% change vs previous period. Accepts a number or a canvas binding like {{myTrendVar}}",
                    "x-binding": true
                },
                "trend": {
                    "type": "string",
                    "enum": ["auto", "up", "down", "neutral"],
                    "description": "auto derives direction from trendValue sign"
                },
                "positiveIsGood": {
                    "type": "boolean",
                    "description": "When false, up trend is red (for error rates, latency etc.)"
                },
                "target": {
                    "type": ["number", "string", "null"],
                    "description": "Goal value — shows a progress bar when set. Accepts a number or a canvas binding like {{myTarget}}",
                    "x-binding": true
                },
                "targetLabelKey": {
                    "type": "string",
                    "description": "i18n translation key for the target label. Renders in all active languages.",
                    "examples": ["forecast", "goal", "budget", "target"]
                },
                "targetLabel": {
                    "type": "string",
                    "description": "Plain string fallback for target label. Used only when targetLabelKey is not set."
                },
                "sparkData": {
                    "type": "array",
                    "description": "Historical data points for sparkline (min 2 to render)",
                    "items": {
                        "type": "object",
                        "properties": {
                            "value": { "type": "number" }
                        }
                    }
                },
                "accentColor": {
                    "type": "string",
                    "enum": ["indigo", "green", "red", "amber", "cyan"]
                },
                "size": {
                    "type": "string",
                    "enum": ["sm", "md", "lg"]
                },
                "locale": {
  "type": "array",
  "description": "Active display languages in order",
  "items": {
    "type": "string",
    "enum": ["en", "ta", "hi", "ar", "fr", "de", "es", "zh", "ja"]
  },
  "default": ["en"]
},
                "cards": {
                    "type": "array",
                    "description": "Array of card configurations for multi-card layout",
                    "items": {
                        "type": "object",
                        "properties": {
                            "labelKey": {
                                "type": "string",
                                "description": "i18n translation key for the metric name"
                            },
                            "label": {
                                "type": "string",
                                "description": "Plain string fallback for metric name"
                            },
                            "value": {
                                "type": ["number", "string"],
                                "x-binding": true
                            },
                            "unit": { "type": "string" },
                            "icon": {
                                "type": "string",
                                "enum": [
                                    "folder",
                                    "trending-up",
                                    "trending-down",
                                    "warning-triangle",
                                    "currency-dollar",
                                    "wallet",
                                    "person-group",
                                    "chart-bar",
                                    "chart-pie",
                                    "clock",
                                    "check-circle",
                                    "flag",
                                    "bolt",
                                    "star"
                                ]
                            },
                            "currency": {
                                "type": ["object", "null"],
                                "properties": {
                                    "symbol": { "type": "string" },
                                    "position": {
                                        "type": "string",
                                        "enum": ["prefix", "suffix"]
                                    },
                                    "compact": { "type": "boolean" },
                                    "decimalPlaces": { "type": "integer" },
                                    "code": { "type": "string" }
                                },
                                "required": ["symbol", "position"]
                            },
                            "trendLabelKey": { "type": "string" },
                            "trendLabel": { "type": "string" },
                            "trendValue": {
                                "type": ["number", "string"],
                                "x-binding": true
                            },
                            "trend": {
                                "type": "string",
                                "enum": ["auto", "up", "down", "neutral"]
                            },
                            "positiveIsGood": { "type": "boolean" },
                            "target": {
                                "type": ["number", "string", "null"],
                                "x-binding": true
                            },
                            "targetLabelKey": { "type": "string" },
                            "targetLabel": { "type": "string" },
                            "accentColor": {
                                "type": "string",
                                "enum": ["indigo", "green", "red", "amber", "cyan"]
                            },
                            "size": {
                                "type": "string",
                                "enum": ["sm", "md", "lg"]
                            },
                            "locale": { "type": "string" },
                            "sparkData": { "type": "array" }
                        }
                    }
                }
            },
            "required": ["labelKey"]
        }
    },
    "events": [
        {
            "name": "onClick",
            "label": "On Click"
        }
    ]
}