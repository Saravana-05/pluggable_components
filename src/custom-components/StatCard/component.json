{
    "name": "StatCard",
    "category": "Cards",
    "type": "local",
    "entry": "./StatCard.tsx",
    "enabled": true,
    "ui": {
        "canvasIcon": "./stat-canvas-icon.svg"
    },
    "presets": [
        {
            "id": "stat-card",
            "label": "Stat Card",
            "thumbnail": "📊",
            "defaultProps": {
                "label": "Metric Name",
                "value": 0,
                "unit": "",
                "trend": "auto",
                "trendValue": 0,
                "positiveIsGood": true,
                "target": null,
                "accentColor": "indigo",
                "size": "md",
                "i18n": {
                    "en": {
                        "vsPrev": "vs prev",
                        "progress": "Progress",
                        "of": "of",
                        "label": "Metric Name"
                    }
                },
                "sparkData": [],
                "icon": "chart-bar",
                "currency": null
            },
            "defaultActions": {
                "iconClick": {
                    "type": "redirect",
                    "url": "/",
                    "target": "_self"
                }
            }
        },
        {
            "id": "dashboard-cards",
            "label": "Dashboard Cards",
            "thumbnail": "📊",
            "defaultProps": {
                "cards": [
                    {
                        "label": "Active Projects",
                        "value": "{{activeProjects}}",
                        "unit": "",
                        "trend": "auto",
                        "trendValue": "{{activeProjectsTrend}}",
                        "trendLabel": "new",
                        "positiveIsGood": true,
                        "target": null,
                        "accentColor": "amber",
                        "size": "md",
                        "i18n": {
                            "en": {
                                "vsPrev": "vs prev",
                                "progress": "Progress",
                                "of": "of",
                                "label": "Active Projects",
                                "trendLabel": "new"
                            },
                            "ta": {
                                "vsPrev": "முந்தையதுடன்",
                                "progress": "முன்னேற்றம்",
                                "of": "/",
                                "label": "செயலில் உள்ள திட்டங்கள்",
                                "trendLabel": "புதியது"
                            }
                        },
                        "sparkData": [],
                        "icon": "folder",
                        "currency": null
                    },
                    {
                        "label": "On Track",
                        "value": "{{onTrackPct}}",
                        "unit": "%",
                        "trend": "auto",
                        "trendValue": "{{onTrackTrend}}",
                        "trendLabel": "%",
                        "positiveIsGood": true,
                        "target": null,
                        "accentColor": "green",
                        "size": "md",
                        "i18n": {
                            "en": {
                                "vsPrev": "vs prev",
                                "progress": "Progress",
                                "of": "of",
                                "label": "On Track"
                            },
                            "ta": {
                                "vsPrev": "முந்தையதுடன்",
                                "progress": "முன்னேற்றம்",
                                "of": "/",
                                "label": "சரியான பாதையில்"
                            }
                        },
                        "sparkData": [],
                        "icon": "trending-up",
                        "currency": null
                    },
                    {
                        "label": "Delayed Projects",
                        "value": "{{delayedProjects}}",
                        "unit": "",
                        "trend": "auto",
                        "trendValue": "{{delayedTrend}}",
                        "trendLabel": "more",
                        "positiveIsGood": false,
                        "target": null,
                        "accentColor": "red",
                        "size": "md",
                        "i18n": {
                            "en": {
                                "vsPrev": "vs prev",
                                "progress": "Progress",
                                "of": "of",
                                "label": "Delayed Projects",
                                "trendLabel": "more"
                            },
                            "ta": {
                                "vsPrev": "முந்தையதுடன்",
                                "progress": "முன்னேற்றம்",
                                "of": "/",
                                "label": "தாமதமான திட்டங்கள்",
                                "trendLabel": "அதிகம்"
                            }
                        },
                        "sparkData": [],
                        "icon": "warning-triangle",
                        "currency": null
                    },
                    {
                        "label": "Revenue vs Forecast",
                        "value": "{{revenueForecast}}",
                        "unit": "",
                        "trend": "neutral",
                        "trendValue": "{{revenueTrend}}",
                        "trendLabel": "%",
                        "positiveIsGood": true,
                        "target": "{{forecastTarget}}",
                        "targetLabel": "Forecast",
                        "accentColor": "amber",
                        "size": "md",
                        "i18n": {
                            "en": {
                                "vsPrev": "vs prev",
                                "progress": "Progress",
                                "of": "of",
                                "label": "Revenue vs Forecast",
                                "targetLabel": "Forecast"
                            },
                            "ta": {
                                "vsPrev": "முந்தையதுடன்",
                                "progress": "முன்னேற்றம்",
                                "of": "/",
                                "label": "வருவாய் எதிர் முன்னறிவிப்பு",
                                "targetLabel": "முன்னறிவிப்பு"
                            }
                        },
                        "sparkData": [],
                        "icon": "currency-dollar",
                        "currency": {
                            "symbol": "$",
                            "position": "prefix",
                            "compact": true
                        }
                    },
                    {
                        "label": "Cash Flow",
                        "value": "{{cashFlow}}",
                        "unit": "",
                        "trend": "auto",
                        "trendValue": "{{cashFlowTrend}}",
                        "trendLabel": "Healthy",
                        "positiveIsGood": true,
                        "target": null,
                        "accentColor": "green",
                        "size": "md",
                        "i18n": {
                            "en": {
                                "vsPrev": "vs prev",
                                "progress": "Progress",
                                "of": "of",
                                "label": "Cash Flow",
                                "trendLabel": "Healthy"
                            },
                            "ta": {
                                "vsPrev": "முந்தையதுடன்",
                                "progress": "முன்னேற்றம்",
                                "of": "/",
                                "label": "பண ஓட்டம்",
                                "trendLabel": "ஆரோக்கியமானது"
                            }
                        },
                        "sparkData": [],
                        "icon": "wallet",
                        "currency": null
                    },
                    {
                        "label": "Resource Utilization",
                        "value": "{{resourceUtilization}}",
                        "unit": "%",
                        "trend": "auto",
                        "trendValue": "{{resourceTrend}}",
                        "trendLabel": "%",
                        "positiveIsGood": true,
                        "target": null,
                        "accentColor": "cyan",
                        "size": "md",
                        "i18n": {
                            "en": {
                                "vsPrev": "vs prev",
                                "progress": "Progress",
                                "of": "of",
                                "label": "Resource Utilization"
                            },
                            "ta": {
                                "vsPrev": "முந்தையதுடன்",
                                "progress": "முன்னேற்றம்",
                                "of": "/",
                                "label": "வள பயன்பாடு"
                            }
                        },
                        "sparkData": [],
                        "icon": "person-group",
                        "currency": null
                    }
                ]
            }
        }
    ],
    "settings": {
        "schema": {
            "type": "object",
            "properties": {
                "label": {
                    "type": "string",
                    "description": "Default metric name shown above the value. Can be overridden per-language via the i18n.{lang}.label key."
                },
                "value": {
                    "type": [
                        "number",
                        "string"
                    ],
                    "description": "Primary numeric value. Accepts a number or a canvas binding like {{myVariable}}",
                    "x-binding": true
                },
                "unit": {
                    "type": "string",
                    "description": "Default unit suffix (e.g. %, ms). Can be overridden per-language via i18n.{lang}.unit."
                },
                "icon": {
                    "type": "string",
                    "description": "Icon identifier shown in the top-left of the card",
                    "enum": [
                        "folder",
                        "trending-up",
                        "trending-down",
                        "warning-triangle",
                        "currency-dollar",
                        "wallet",
                        "person-group",
                        "chart-bar",
                        "chart-pie",
                        "clock",
                        "check-circle",
                        "flag",
                        "bolt",
                        "star"
                    ]
                },
                "i18n": {
                    "type": "object",
                    "description": "Multilingual label map. Keys are BCP-47 language codes (e.g. \"en\", \"ta\", \"fr\", \"ar\"). Values are label maps for each language. The first key becomes the default active language. When two or more languages are supplied, a language-selector appears at the bottom of the card.",
                    "additionalProperties": {
                        "type": "object",
                        "description": "Label map for a single language. All keys are optional — missing keys fall back to built-in English strings.",
                        "properties": {
                            "vsPrev": {
                                "type": "string",
                                "description": "Suffix shown in the trend badge, e.g. \"vs prev\" or \"vs préc.\""
                            },
                            "progress": {
                                "type": "string",
                                "description": "Label shown above the progress bar, e.g. \"Progress\" or \"Progression\""
                            },
                            "of": {
                                "type": "string",
                                "description": "Separator between progress percentage and target, e.g. \"of\" or \"/\""
                            },
                            "label": {
                                "type": "string",
                                "description": "Overrides the top-level `label` prop for this language"
                            },
                            "unit": {
                                "type": "string",
                                "description": "Overrides the top-level `unit` prop for this language"
                            },
                            "targetLabel": {
                                "type": "string",
                                "description": "Overrides the top-level `targetLabel` prop for this language"
                            },
                            "trendLabel": {
                                "type": "string",
                                "description": "Overrides the top-level `trendLabel` prop for this language"
                            }
                        },
                        "additionalProperties": {
                            "type": "string",
                            "description": "Any custom label key-value pairs for this language"
                        }
                    },
                    "examples": [
                        {
                            "en": {
                                "vsPrev": "vs prev",
                                "progress": "Progress",
                                "of": "of",
                                "label": "Revenue"
                            },
                            "ta": {
                                "vsPrev": "முந்தையதுடன்",
                                "progress": "முன்னேற்றம்",
                                "of": "/",
                                "label": "வருவாய்"
                            },
                            "ar": {
                                "vsPrev": "مقابل السابق",
                                "progress": "التقدم",
                                "of": "من",
                                "label": "الإيرادات"
                            }
                        }
                    ]
                },
                "activeLocale": {
                    "type": "string",
                    "description": "Programmatically control the active language from outside the component. Must match a key present in `i18n`. Changing this prop triggers `onLanguageChange`."
                },
                "currency": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "description": "Currency formatting config. Set null to disable.",
                    "properties": {
                        "symbol": {
                            "type": "string",
                            "description": "Currency symbol e.g. $, €, £, ₹, ¥"
                        },
                        "position": {
                            "type": "string",
                            "enum": [
                                "prefix",
                                "suffix"
                            ]
                        },
                        "compact": {
                            "type": "boolean",
                            "description": "Shorten large numbers: 2400000000 → $2.4B"
                        },
                        "decimalPlaces": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 4
                        },
                        "code": {
                            "type": "string",
                            "description": "ISO 4217 currency code e.g. USD, EUR, INR"
                        }
                    },
                    "required": [
                        "symbol",
                        "position"
                    ]
                },
                "trendLabel": {
                    "type": "string",
                    "description": "Default custom label in the trend badge. Can be overridden per-language via i18n.{lang}.trendLabel."
                },
                "trendValue": {
                    "type": [
                        "number",
                        "string"
                    ],
                    "description": "% change vs previous period (negative = down). Accepts a number or a canvas binding.",
                    "x-binding": true
                },
                "trend": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "up",
                        "down",
                        "neutral"
                    ],
                    "description": "auto derives direction from trendValue sign"
                },
                "positiveIsGood": {
                    "type": "boolean",
                    "description": "When false, an up trend is shown in red (for error rates, latency, etc.)"
                },
                "target": {
                    "type": [
                        "number",
                        "string",
                        "null"
                    ],
                    "description": "Goal value — shows a progress bar when set.",
                    "x-binding": true
                },
                "targetLabel": {
                    "type": "string",
                    "description": "Default label shown next to the target value. Can be overridden via i18n.{lang}.targetLabel."
                },
                "sparkData": {
                    "type": "array",
                    "description": "Historical data points for sparkline (min 2 to render)",
                    "items": {
                        "type": "object",
                        "properties": {
                            "value": {
                                "type": "number"
                            }
                        }
                    }
                },
                "accentColor": {
                    "type": "string",
                    "enum": [
                        "indigo",
                        "green",
                        "red",
                        "amber",
                        "cyan"
                    ]
                },
                "size": {
                    "type": "string",
                    "enum": [
                        "sm",
                        "md",
                        "lg"
                    ]
                },
                "cards": {
                    "type": "array",
                    "description": "Array of card configurations for multi-card layout",
                    "items": {
                        "type": "object",
                        "properties": {
                            "label": {
                                "type": "string"
                            },
                            "value": {
                                "type": [
                                    "number",
                                    "string"
                                ],
                                "x-binding": true
                            },
                            "unit": {
                                "type": "string"
                            },
                            "icon": {
                                "type": "string",
                                "enum": [
                                    "folder",
                                    "trending-up",
                                    "trending-down",
                                    "warning-triangle",
                                    "currency-dollar",
                                    "wallet",
                                    "person-group",
                                    "chart-bar",
                                    "chart-pie",
                                    "clock",
                                    "check-circle",
                                    "flag",
                                    "bolt",
                                    "star"
                                ]
                            },
                            "i18n": {
                                "type": "object",
                                "description": "Per-card multilingual label map. Same structure as the top-level i18n prop.",
                                "additionalProperties": {
                                    "type": "object",
                                    "properties": {
                                        "vsPrev": {
                                            "type": "string"
                                        },
                                        "progress": {
                                            "type": "string"
                                        },
                                        "of": {
                                            "type": "string"
                                        },
                                        "label": {
                                            "type": "string"
                                        },
                                        "unit": {
                                            "type": "string"
                                        },
                                        "targetLabel": {
                                            "type": "string"
                                        },
                                        "trendLabel": {
                                            "type": "string"
                                        }
                                    },
                                    "additionalProperties": {
                                        "type": "string"
                                    }
                                }
                            },
                            "currency": {
                                "type": [
                                    "object",
                                    "null"
                                ],
                                "properties": {
                                    "symbol": {
                                        "type": "string"
                                    },
                                    "position": {
                                        "type": "string",
                                        "enum": [
                                            "prefix",
                                            "suffix"
                                        ]
                                    },
                                    "compact": {
                                        "type": "boolean"
                                    },
                                    "decimalPlaces": {
                                        "type": "integer"
                                    },
                                    "code": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "symbol",
                                    "position"
                                ]
                            },
                            "trendValue": {
                                "type": [
                                    "number",
                                    "string"
                                ],
                                "x-binding": true
                            },
                            "trendLabel": {
                                "type": "string"
                            },
                            "trend": {
                                "type": "string",
                                "enum": [
                                    "auto",
                                    "up",
                                    "down",
                                    "neutral"
                                ]
                            },
                            "positiveIsGood": {
                                "type": "boolean"
                            },
                            "target": {
                                "type": [
                                    "number",
                                    "string",
                                    "null"
                                ],
                                "x-binding": true
                            },
                            "targetLabel": {
                                "type": "string"
                            },
                            "accentColor": {
                                "type": "string",
                                "enum": [
                                    "indigo",
                                    "green",
                                    "red",
                                    "amber",
                                    "cyan"
                                ]
                            },
                            "size": {
                                "type": "string",
                                "enum": [
                                    "sm",
                                    "md",
                                    "lg"
                                ]
                            },
                            "sparkData": {
                                "type": "array"
                            }
                        }
                    }
                },
                "labels": {
                    "type": "object",
                    "description": "Deprecated — use i18n instead. Override any displayed label string.",
                    "properties": {
                        "trend_up": {
                            "type": "string"
                        },
                        "trend_down": {
                            "type": "string"
                        },
                        "trend_neutral": {
                            "type": "string"
                        },
                        "vs_period": {
                            "type": "string"
                        },
                        "target": {
                            "type": "string"
                        },
                        "current": {
                            "type": "string"
                        }
                    }
                }
            },
            "required": [
                "label",
                "value"
            ]
        }
    },
    "events": [
        {
            "name": "onClick",
            "label": "On Click"
        },
        {
            "name": "onLanguageChange",
            "label": "On Language Change",
            "description": "Fired whenever the active language changes, either by the user clicking the language selector or by an external activeLocale prop update.",
            "payload": {
                "type": "object",
                "properties": {
                    "prev": {
                        "type": "string",
                        "description": "BCP-47 code of the language that was active before the switch (e.g. \"en\")"
                    },
                    "next": {
                        "type": "string",
                        "description": "BCP-47 code of the language now active (e.g. \"ta\")"
                    },
                    "labels": {
                        "type": "object",
                        "description": "Full merged label map for the newly active language. All built-in keys are guaranteed to be present.",
                        "properties": {
                            "vsPrev": {
                                "type": "string"
                            },
                            "progress": {
                                "type": "string"
                            },
                            "of": {
                                "type": "string"
                            },
                            "label": {
                                "type": "string"
                            },
                            "unit": {
                                "type": "string"
                            },
                            "targetLabel": {
                                "type": "string"
                            },
                            "trendLabel": {
                                "type": "string"
                            }
                        },
                        "additionalProperties": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "prev",
                    "next",
                    "labels"
                ]
            }
        }
    ]
}